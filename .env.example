NODE_ENV=""

DATABASE_URL=""

REDIS_HOST=""
REDIS_PORT=
REDIS_PASSWORD=""
REDIS_USER=""

# Required only if email is enabled in lobby.config.json
RESEND_API_KEY=""
RESEND_CONFIRMATION_TEMPLATE_ID=""

# Override if process.cwd() doesn't resolve to the project root (e.g. Docker)
PROJECT_ROOT=""

# Domain configuration for CORS
APP_DOMAIN=""

# TLS/SSL configuration for PostgreSQL connections.
# Required for managed databases (Supabase, RDS, etc.) that enforce encrypted connections.
DATABASE_SSL=

# Absolute path to the CA certificate file for verifying the database server's identity.
# Required only when DATABASE_SSL=true. Your provider will supply this file.
DATABASE_CA_CERT_PATH=""
